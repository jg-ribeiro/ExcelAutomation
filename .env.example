# ==============================================================================
# Configurações de Ambiente — Excel Automation VM
# ==============================================================================

# Entrega de Arquivos Estáticos pelo Python (true = serve frontend/dist na raiz, false = apenas API)
SERVE_STATIC=true

# Configurações do Active Directory (LDAP) da Usina
LDAP_SERVER=localhost
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=DC=localhost
LDAP_DOMAIN=localhost.com.br

# Administrador Inicial (Utilizado EXCLUSIVAMENTE no primeiro login; bloqueado após ativação)
INITIAL_ADMIN_USER=user

# Segurança do Token de Sessão JWT
JWT_SECRET_KEY=auteq_usacucar_excel_secret_key_2026_jwt_token_secure
JWT_EXPIRATION_HOURS=8
